{
    "name": "ghostwriter/http",
    "description": "HTTP Client and Server abstraction for PHP.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "ghostwriter",
        "http"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/http",
    "support": {
        "issues": "https://github.com/ghostwriter/http/issues",
        "forum": "https://github.com/ghostwriter/http/discussions",
        "source": "https://github.com/ghostwriter/http",
        "docs": "https://github.com/ghostwriter/http",
        "rss": "https://github.com/ghostwriter/http/releases.atom",
        "security": "https://github.com/ghostwriter/http/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ghostwriter/container": "^7.0.2",
        "guzzlehttp/guzzle": "^8.1.0",
        "laminas/laminas-diactoros": "^3.8.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1.0",
        "psr/http-message": "^2.0.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "boundwize/structarmed": "^0.16.26",
        "ghostwriter/coding-standard": "dev-main",
        "ghostwriter/phpunit-assertions": "^0.1.1",
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ghostwriter\\Http\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "ghostwriter": {
            "container": {
                "provider": [
                    "Ghostwriter\\Http\\Container\\HttpProvider"
                ]
            }
        },
        "thanks": {
            "name": "ghostwriter/http",
            "url": "https://github.com/ghostwriter/http"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "vendor/ghostwriter/coding-standard/tools/phar/infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpunit": [
            "@xdebug",
            "vendor/bin/phpunit --do-not-cache-result --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
